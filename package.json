{
  "name": "playwright-cucumber-bdd-framework",
  "version": "1.0.0",
  "description": "Playwright TypeScript Cucumber BDD Automation Framework",
  "main": "index.js",
  "scripts": {
    "test": "npx cucumber-js",
    "test:smoke": "npx cucumber-js --tags \"@smoke\"",
    "test:regression": "npx cucumber-js --tags \"@regression\"",
    "test:headed": "set HEADLESS=false&& npx cucumber-js",
    "report": "start reports/cucumber-report.html"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "bdd",
    "typescript"
  ],
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "dotenv": "^18.0.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "xlsx": "^0.18.5"
  }
}
